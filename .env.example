PORT=3000
HOST=0.0.0.0

# OpenAI (server-side only, never exposed to the PWA client)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Puppeteer automation
# headless=false needs a display; use headless=new on a server with no X
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SLOWMO=120

# OLM endpoints (auto-probed at startup, these are the fallbacks)
OLM_BASE_URL=https://olm.vn
OLM_LOGIN_URL=https://olm.vn/dangnhap
OLM_HOMEWORK_URL=https://olm.vn/hoat-dong
OLM_ACTIVITY_URL=https://olm.vn/bai-tap

# Force a specific engine: auto | http | browser
OLM_ENGINE=auto

# Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
MAX_RUN_BODIES_PER_HOUR=6