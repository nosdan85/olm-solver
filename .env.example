PORT=3000
HOST=0.0.0.0

# OpenAI-compatible endpoint (server-side only, never exposed to the PWA client).
# For Gemini use: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# For OpenAI directly: OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gemini-3.8-flash

# Header used to send the key: 'bearer' (default) or 'x-api-key' (opencode zen).
OPENAI_AUTH_HEADER=bearer

# GPT-5/6 only: none | minimal | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_TOKENS=2048

# Optional second provider. Used automatically when the primary errors out
# (out of quota, bad key, model unavailable). Leave blank to disable.
# FALLBACK_MODELS accepts a comma-separated list: each model is tried in turn,
# which matters for Gemini free tier (every model has its own 20 req/day cap).
FALLBACK_BASE_URL=
FALLBACK_MODELS=
FALLBACK_API_KEY=
FALLBACK_AUTH_HEADER=bearer

# Puppeteer automation
# headless=false needs a display; use headless=new on a server with no X
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SLOWMO=120

# OLM endpoints (auto-probed at startup, these are the fallbacks)
OLM_BASE_URL=https://olm.vn
OLM_LOGIN_URL=https://olm.vn/dangnhap
OLM_HOMEWORK_URL=https://olm.vn/hoat-dong
OLM_ACTIVITY_URL=https://olm.vn/bai-tap

# Force a specific engine: auto | http | browser
OLM_ENGINE=auto

# Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
MAX_RUN_BODIES_PER_HOUR=6